# Copie ce fichier en `.env` et adapte les valeurs (ou définis les variables
# directement dans Vercel : Settings -> Environment Variables).

# Clé de signature des sessions Flask : une chaîne aléatoire longue et secrète.
APP_SECRET_KEY=change-moi-en-production

# URL de connexion PostgreSQL (Neon / Vercel Postgres / Supabase).
# Sur Vercel, l'intégration Postgres/Neon l'injecte automatiquement.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# (Optionnel) Vraies données on-chain via Moralis (https://moralis.com, offre gratuite).
# Sans cette clé, les performances des wallets sont simulées.
# MORALIS_API_KEY=
# ONCHAIN_MAX_FETCHES_PER_DAY=250
# ONCHAIN_CACHE_TTL_SECONDS=1200

# (Optionnel) Notifications push sur le téléphone (Web Push / VAPID).
# Sans ces deux clés, le bloc "Notifications" est simplement masqué.
# Génère une paire avec : npx web-push generate-vapid-keys
# (ou n'importe quel générateur de clés VAPID P-256 ; clé privée en base64url, PKCS8 ou brute 32 octets).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://ton-site.vercel.app
