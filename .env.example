# Copie ce fichier en `.env` et adapte les valeurs (puis charge-le avec
# python-dotenv, ou exporte les variables directement sur ton serveur).

# Obligatoire en production : une chaîne aléatoire longue et secrète.
SECRET_KEY=change-moi-en-production

# Obligatoire : URL de connexion PostgreSQL (Neon / Vercel Postgres / Supabase).
# Sur Vercel, cette variable est injectée automatiquement si tu crées une base
# Vercel Postgres depuis l'onglet Storage du projet.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# URL publique de l'app (utilisée pour les redirections Stripe)
APP_BASE_URL=http://127.0.0.1:5000

# --- Stripe (optionnel) ---
# Sans ces variables, l'app tourne en "mode démo" : le bouton "Passer Pro"
# active le plan Pro directement, sans paiement réel.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Fil d'actus automatique (scripts/fetch_news.py) ---
# Token partagé entre le script de récupération d'actus et l'app.
ADMIN_REFRESH_TOKEN=choisis-un-token-secret-long
