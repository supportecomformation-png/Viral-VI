{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "schema.sql",
          "app.py",
          "config.py",
          "db.py",
          "auth.py",
          "auth_utils.py",
          "sim.py",
          "onchain.py",
          "markets.py",
          "push.py"
        ]
      }
    }
  ],
  "regions": ["fra1"],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
